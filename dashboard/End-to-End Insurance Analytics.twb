      <aliases enabled='yes' />
      <column caption='Total Cases' datatype='integer' name='[Calculation_3815408204804096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([case_id])' />
      </column>
      <column caption='Avg Severity' datatype='real' name='[Calculation_3815408205914113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3815408210563078] / [Calculation_3815408204804096]' />
      </column>
      <column caption='Case Start Time' datatype='date' name='[Calculation_3815408207904770]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [case_id] : MIN(IF [activity_name] = &apos;First Notification of Loss (FNOL)&apos; THEN [timestamp] END) }' />
      </column>
      <column caption='Case End Time' datatype='date' name='[Calculation_3815408208121859]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [case_id] : MAX(IF [activity_name] = &apos;Close Claim&apos; THEN [timestamp] END) }' />
      </column>
      <column caption='Cycle Time (Days)' datatype='integer' name='[Calculation_3815408208318468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_3815408207904770], [Calculation_3815408208121859])' />
      </column>
      <column caption='RPA Adoption Rate' datatype='real' name='[Calculation_3815408209367045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [user_type] = &apos;RPA&apos; THEN [case_id] END) &#10;/ &#10;COUNTD([case_id])' />
      </column>
      <column caption='Total Claimed Amount' datatype='real' name='[Calculation_3815408210563078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [case_id] : MAX([claim_amount]) })' />
      </column>
      <column caption='Unique Claim Amount' datatype='real' name='[Calculation_3815408212529159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [case_id] : MAX([claim_amount]) }' />
      </column>
      <column caption='Time from Start (Hours)' datatype='integer' name='[Calculation_3815408232329224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;hour&apos;, { FIXED [case_id]: MIN([timestamp]) }, [timestamp])' />
      </column>
      <column caption='Time to Decision (Days)' datatype='integer' name='[Calculation_3815408234717193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_3815408207904770], { FIXED [case_id]: MAX(IF [activity_name]=&apos;Claim Decision&apos; THEN [timestamp] END) })' />
      </column>
      <column caption='Time: FNOL' datatype='date' name='[Calculation_3815408248004618]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [case_id]: MIN(IF [activity_name]=&apos;First Notification of Loss (FNOL)&apos; THEN [timestamp] END) }' />
      </column>
      <column caption='Time: Assign' datatype='date' name='[Calculation_3815408248307723]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [case_id]: MIN(IF [activity_name]=&apos;Assign Claim&apos; THEN [timestamp] END) }' />
      </column>
      <column caption='Time: Decision' datatype='date' name='[Calculation_3815408248455180]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [case_id]: MIN(IF [activity_name]=&apos;Claim Decision&apos; THEN [timestamp] END) }' />
      </column>
      <column caption='FNOL - Assign' datatype='real' name='[Calculation_3815408248848397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(DATEDIFF(&apos;day&apos;, [Calculation_3815408248004618], [Calculation_3815408248307723]))' />
      </column>
      <column caption='Assign - Decision' datatype='real' name='[Calculation_3815408249016334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(DATEDIFF(&apos;day&apos;, [Calculation_3815408248307723], [Calculation_3815408248455180]))' />
      </column>
      <column aggregation='None' caption='Claimant Age (bin)' datatype='integer' name='[Claimant Age (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[claimant_age]' peg='0' size='5' />
      </column>
